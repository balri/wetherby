		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"jsdom": "^26.0.0",
		"lint-staged": "^16.4.0",
		"prettier": "^3.9.10",
		"vercel": "^65.12.1",
		"vitest": "^4.0.0"
