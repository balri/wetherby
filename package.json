{
	"name": "wetherby-papers",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:vercel": "vercel dev",
		"build": "vite build",
		"preview": "vite preview",
		"format": "prettier --write \"src/**/*.{js,jsx,css}\" \"api/**/*.js\" package.json vercel.json",
